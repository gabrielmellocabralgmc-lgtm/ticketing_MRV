# ======================================================================
# Produção: Vercel (app) + Neon (banco, projeto "Ticketing MRV", São Paulo) + Resend (e-mail)
# Valores reais ficam só na Vercel → Settings → Environment Variables. Nunca commitar valores reais.
# Para testar no computador não precisa de nada disto: use `npm run demo`.
# ======================================================================

# Neon → Connect → banco neondb, Connection pooling LIGADO (host termina em "-pooler"). Usada pelo app.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Neon → Connect → banco neondb, Connection pooling DESLIGADO. Usada só pelas migrações a cada deploy.
DATABASE_URL_DIRETA=postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Assina o cookie de sessão. Gerar com: openssl rand -base64 48
AUTH_SECRET=

# Endereço público do sistema (vai nos links dos e-mails). Sem barra no final.
# Opcional na Vercel (ela informa o domínio de produção sozinha).
SITE_URL=https://ticketing-mrv.vercel.app

# Protege as rotinas automáticas (/api/cron/*), chamadas pelo GitHub Actions e pelo cron da Vercel.
# Gerar com: openssl rand -hex 24. O mesmo valor vai no secret CRON_SECRET do GitHub.
CRON_SECRET=

# Resend. Domínio verificado: ingressos.weareact3.com
RESEND_API_KEY=
EMAIL_REMETENTE="Ingressos MRV <naoresponda@ingressos.weareact3.com>"
# opcional: para onde vão as respostas e os avisos de dúvidas (padrão ingresso.mrv@weareact3.com)
EMAIL_RESPONDER_PARA=
EMAIL_OPERACIONAL=

# Admin garantido a cada deploy (se ainda não for Admin, vira).
ADMIN_EMAIL=
ADMIN_NOME=
# opcional, emergência: com ADMIN_EMAIL + ADMIN_SENHA o Admin entra com senha na tela de login
ADMIN_SENHA=

# opcional, só para testes: MODO_TESTE=1 libera "Entrar como" outro usuário (Admin)
MODO_TESTE=
