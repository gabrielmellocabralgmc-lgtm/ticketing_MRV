# Supabase (Project Settings → API). Local: valores impressos por `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (páginas públicas /i/[token], cron, cadastro de usuários). Nunca expor.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do sistema (vai nos links de convite e do torcedor)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron manda "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=troque-por-um-valor-aleatorio

# Conexão direta ao Postgres, usada pelo importador de planilha via linha de comando
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
