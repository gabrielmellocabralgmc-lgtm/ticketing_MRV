# ======================================================================
# Produção: Railway (app) + Neon (banco) + Resend (e-mail)
# Configure estas variáveis no Railway → serviço → Variables. Nunca commitar valores reais.
# ======================================================================

# Neon → Connection string COM pooler (host termina em "-pooler"). Usada pelo app.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/ticketing_mrv?sslmode=require
# Neon → Connection string SEM pooler. Usada só pelas migrações a cada deploy (recomendado).
DATABASE_URL_DIRETA=postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/ticketing_mrv?sslmode=require

# Assina o cookie de sessão. Gerar com: openssl rand -base64 48
AUTH_SECRET=

# Endereço público do sistema (vai nos links dos e-mails). Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://ticketing-mrv.up.railway.app

# Protege as rotinas automáticas (/api/cron/*). Gerar com: openssl rand -hex 24
# Com ele definido, o próprio servidor dispara as rotinas (lembretes, prazos, retenção).
CRON_SECRET=

# Resend (mesma conta do adidas_ingressos). Domínio verificado: ingressos.weareact3.com
RESEND_API_KEY=
EMAIL_REMETENTE="Ingressos MRV <naoresponda@ingressos.weareact3.com>"
# opcional: respostas vão para o Marketing
EMAIL_RESPONDER_PARA=

# Primeiro acesso: no primeiro deploy, este e-mail vira Admin (se ainda não houver nenhum).
ADMIN_EMAIL=
ADMIN_NOME=
